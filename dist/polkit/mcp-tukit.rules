// mcp-server-tukit behind mcp-gateway runs as mcp-tukit. Its reboot tool
// starts mcp-tukit-reboot.service (transactional-update reboot); this rule
// lets the account start that unit, and nothing else, without a password.
// Whether a call gets there is the gateway's policy: role tukit-operator,
// with an approval for every reboot.
polkit.addRule(function(action, subject) {
    if (subject.user == "mcp-tukit" &&
        action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "mcp-tukit-reboot.service" &&
        action.lookup("verb") == "start")
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
