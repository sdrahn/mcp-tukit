policy_module(mcp_tukit, 0.1.0)

# mcp-server-tukit (github.com/sdrahn/mcp-tukit) behind mcp-gateway.
# The server holds no privileges of its own: every tool is a call to
# tukitd (org.opensuse.tukit) over the system bus, and tukitd creates,
# mounts and closes the snapshots and runs zypper in them. So the domain
# needs the gateway's backend baseline and the D-Bus chat with tukitd,
# nothing else: no capabilities, no mounts, no btrfs ioctls, no access
# to /.snapshots, no exec of other programs. tukitd checks nothing
# itself: the D-Bus policy (dist/dbus) lets the account mcp-tukit call
# it, and the gateway's roles and approvals decide who gets there.

mcp_gateway_backend_template(tukit)

dbus_system_bus_client(mcpsrv_tukit_t)

# tukitd: openSUSE's policy has no module for it (/usr/sbin/tukitd is
# bin_t), so systemd runs it as unconfined_service_t. Calls go there;
# its replies and its signals (CommandExecuted, Error) come back.
optional_policy(`
	gen_require(`
		type unconfined_service_t;
		class dbus send_msg;
	')
	allow mcpsrv_tukit_t unconfined_service_t:dbus send_msg;
	allow unconfined_service_t mcpsrv_tukit_t:dbus send_msg;
')

# Should a policy give tukitd a domain of its own (tukitd_t), the same.
optional_policy(`
	gen_require(`
		type tukitd_t;
		class dbus send_msg;
	')
	allow mcpsrv_tukit_t tukitd_t:dbus send_msg;
	allow tukitd_t mcpsrv_tukit_t:dbus send_msg;
')
